local Players = game:GetService("Players")
local expiryTime = 1682367600 -- Thời gian hết hạn

local kickMessage = [[

Script đang được tạo vui lòng chờ đợi
vui lòng vào discord để biết script xong chưa
	discord.gg/vxezehub


]]

local function checkExpiry()
    if os.time() > expiryTime then
        for _, player in ipairs(Players:GetPlayers()) do
            player:Kick(kickMessage)
        end
        return true
    end
    return false
end

local isExpired = checkExpiry()
if not isExpired then
    Players.PlayerAdded:Connect(function(player)
        if os.time() > expiryTime then
            player:Kick(kickMessage)
        end
    end)
end
